DATABASE_URL=postgresql+asyncpg://koober:koober@127.0.0.1:5432/koober
JWT_SECRET=dev-change-me-please-use-32-bytes-min
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
GOOGLE_CLIENT_ID=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=koober@localhost
APP_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MEDIA_DIR=media
ADMIN_USERNAME=admin
ADMIN_PASSWORD=koober-admin
STT_PROVIDER=faster_whisper
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# Talk followups: stub (offline) or groq (free Llama API — https://console.groq.com)
LLM_PROVIDER=stub
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TURNS=5
LLM_TIMEOUT_SECONDS=8
# Set false only if Groq fails with SSL CERTIFICATE_VERIFY_FAILED (corp proxy)
LLM_SSL_VERIFY=true
