{
  "expo": {
    "name": "Koober",
    "slug": "koober",
    "scheme": "koober",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/koober-bear.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/koober-bear.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B5BD6"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "dev.koober.app" },
    "android": {
      "package": "dev.koober.app",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Koober to hear your child's answers."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
