{
  "expo": {
    "name": "Kick",
    "slug": "koober",
    "scheme": "koober",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/koober-bear.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.koober.app"
    },
    "android": {
      "package": "dev.koober.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Kick to hear your child's answers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/koober-bear.png",
          "resizeMode": "contain",
          "backgroundColor": "#5B5BD6",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
